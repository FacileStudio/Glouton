# Glouton — production environment (docker compose)

# Public URL of the app
DOMAIN=https://glouton.facile.studio

# JWT signing + at-rest encryption (min 32 chars, keep stable)
ENCRYPTION_SECRET=change-me-to-a-stable-random-value-32+

# PostgreSQL password (optional, defaults to "glouton")
# POSTGRES_PASSWORD=glouton

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/glouton/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# Defaults derived from DOMAIN when unset:
# OIDC_REDIRECT_URL=https://glouton.facile.studio/auth/oidc/callback
# OIDC_SUCCESS_URL=https://glouton.facile.studio/auth/callback

# Hide password auth entirely (requires OIDC)
# SSO_ONLY=true

# Courrier (optional; needs OIDC). Unset keeps every mail on SMTP.
# COURRIER_URL=https://courrier.facile.studio

# Bulle writing assistant (optional; needs OIDC). Unset hides Bulle in the composer.
# BULLE_URL=https://bulle.facile.studio
