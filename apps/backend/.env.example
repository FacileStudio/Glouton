DOMAIN=http://localhost:3000
PORT=3001

ENCRYPTION_SECRET=change-me-min-32-chars-required

# PostgreSQL Database URL
# In Docker Compose this is set for you.
DATABASE_URL=postgresql://user@localhost:5432/myapp

# Redis Configuration (required for job queues)
# In Docker Compose this is set for you.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

HUNTER_API_KEY=
