{
  "name": "glouton",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "cleanup:stuck-hunts": "bun run scripts/cleanup-stuck-hunts.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": ">=3.1.3",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.10",
    "flatted": ">=3.4.0",
    "brace-expansion": ">=1.1.13",
    "underscore": ">=1.13.8",
    "yaml": ">=2.8.3",
    "ws": ">=8.20.1",
    "follow-redirects": ">=1.15.12",
    "devalue": ">=5.6.4",
    "rollup": ">=4.59.0",
    "uuid": ">=11.1.1",
    "cookie": ">=0.7.0",
    "ajv": ">=6.14.0",
    "lodash": ">=4.17.24",
    "undici": ">=7.24.0",
    "svelte": ">=5.55.7",
    "vite": ">=8.0.0",
    "axios": ">=1.15.2",
    "storybook": ">=10.0.0"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=18.0.0"
  }
}
