{
  "name": "glouton",
  "license": "AGPL-3.0-only",
  "version": "0.20.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "cleanup:stuck-hunts": "bun run scripts/cleanup-stuck-hunts.ts",
    "backfill:contacts": "bun run scripts/backfill-contacts.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.32",
    "flatted": "^3.4.2",
    "brace-expansion": "^5.0.13",
    "underscore": "^1.13.8",
    "yaml": "^2.9.0",
    "ws": ">=8.20.1",
    "follow-redirects": "^1.16.3",
    "devalue": "^5.9.4",
    "rollup": "^4.60.4",
    "uuid": ">=11.1.1",
    "cookie": "^1.1.1",
    "lodash": "^4.18.1",
    "undici": "^7.30.2",
    "svelte": "^5.57.3",
    "vite": "^8.3.8",
    "axios": "^1.21.1",
    "storybook": ">=10.0.0",
    "shell-quote": "^1.12.0"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=18.0.0"
  }
}
