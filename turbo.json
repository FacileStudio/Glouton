{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "BACKEND_URL",
    "DATABASE_URL",
    "DOMAIN",
    "ENCRYPTION_SECRET",
    "HUNTER_API_KEY",
    "NODE_ENV",
    "PORT",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT"
  ],
  "tasks": {
    "check-env": {
      "cache": false,
      "inputs": ["**/.env*", "src/env.ts", "src/lib/env.ts"]
    },
    "build": {
      "dependsOn": ["^build", "check-env"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".svelte-kit/**"]
    },
    "dev": {
      "dependsOn": ["check-env"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
